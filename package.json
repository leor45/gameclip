{
  "name": "gameclip",
  "version": "0.5.1",
  "description": "Captura de clips de juegos y grabación de escritorio, 100% local",
  "private": true,
  "main": "out/main/index.js",
  "author": "Leo",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "electron-vite build",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-haptic-mute.ps1",
    "build:portable": "electron-vite build && npm run build:native && electron-builder --win portable",
    "icon": "electron scripts/build-icon.cjs",
    "postinstall": "node scripts/rebuild-sqlite-electron.mjs"
  },
  "dependencies": {
    "@streamlabs/obs-studio-node": "https://s3-us-west-2.amazonaws.com/obsstudionodes3.streamlabs.com/osn-0.26.29b18-release-win64.tar.gz",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "better-sqlite3-electron": "npm:better-sqlite3@^11.10.0",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "electron": "29.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.0"
  }
}
