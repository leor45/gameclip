# Preferencias por máquina (nunca al repo)
preferences.local.json

# Dependencias y builds
node_modules/
dist/
out/
release/
*.tsbuildinfo

# Helpers nativos compilados: se generan desde native/ con scripts/build-*.ps1 (en build:native /
# build:portable). El fuente y el script sí van al repo; el binario no.
resources/gc-app-audio-mute.exe
resources/gc-controller-listen.exe
resources/gc-perf-sensors.exe
resources/gc-presentmon.exe
# Las DLLs de resources/ son TODAS dependencias de gc-perf-sensors bajadas del NuGet (LHM 0.9.6 trae
# un cierre de 10, no la sola LibreHardwareMonitorLib de la 0.9.4), y el .config lleva sus binding
# redirects. Por patrón y no una a una: enumerarlas se desincroniza con el script en cuanto cambie
# una versión, y una DLL suelta acabaría commiteada como binario.
resources/*.dll
resources/gc-perf-sensors.exe.config

# SDK de GameInput descargado del NuGet para compilar gc-controller-listen (cabeceras de Microsoft;
# no se vendorizan por licencia). Lo baja scripts/build-controller-listen.ps1.
build/gameinput-sdk/

# Librerías del NuGet para compilar gc-perf-sensors. Las baja scripts/build-perf-sensors.ps1.
build/perf-sensors-sdk/

# Datos locales
*.sqlite
*.sqlite3
*.db
server/data/

# Entorno
.env
.env.*
!.env.example

# Logs y temporales (incluye build/icon.log, la traza de `npm run icon`)
*.log
.DS_Store
Thumbs.db
